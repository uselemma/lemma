{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        "runtime/**",
        "scripts/**",
        "extensions/**",
        "hermes-plugin/lemma/runtime/**"
      ]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build", "^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
