# Lemma — required to send traces. Copy to examples/.env
# https://platform.uselemma.ai
LEMMA_API_KEY=
LEMMA_PROJECT_ID=
LEMMA_RELEASE=
# Optional identity stamped on every turn in the REPL
LEMMA_USER_ID=

# OpenAI — every example uses gpt-4o-mini as the common model
OPENAI_API_KEY=

# Optional: SDK debug logs (trace started / sending / sent)
# LEMMA_DEBUG=1
